<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/booking_widget_background" android:padding="12dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="24dp" android:text="JUJA · BOOKING CALENDAR" android:textStyle="bold" android:textSize="13sp" android:textColor="#142A3E" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_prev" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:contentDescription="Previous month" android:textSize="24sp" android:textColor="#142A3E" />
        <TextView android:id="@+id/widget_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="14sp" android:textColor="#142A3E" />
        <TextView android:id="@+id/widget_next" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:contentDescription="Next month" android:textSize="24sp" android:textColor="#142A3E" />
        <TextView android:id="@+id/widget_today" android:layout_width="45dp" android:layout_height="match_parent" android:gravity="center" android:text="Today" android:textSize="11sp" android:textColor="#0B6942" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:contentDescription="Refresh bookings" android:textSize="22sp" android:textColor="#0B6942" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" />
    <LinearLayout android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_selected" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:textSize="11sp" android:textStyle="bold" android:textColor="#142A3E" />
    <LinearLayout android:id="@+id/widget_bookings" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:text="Open POS and sign in to connect" android:textSize="10sp" android:textColor="#64748B" />
</LinearLayout>
